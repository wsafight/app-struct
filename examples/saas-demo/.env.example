DATABASE_URL=postgresql://appstruct:appstruct-dev@127.0.0.1:5432/appstruct?sslmode=disable
APPSTRUCT_ALLOWED_ORIGIN=http://127.0.0.1:5173
APPSTRUCT_AUTH_MAIL_MODE=capture
APPSTRUCT_ENV=development
APPSTRUCT_FILE_ROOT=.appstruct/files
# Generate a unique value with: openssl rand -base64 32
APPSTRUCT_REPORT_SNAPSHOT_KEY=
APPSTRUCT_AUTH_MFA_KEY=
# Optional in development; configure all three together for Stripe checkout.
# APPSTRUCT_STRIPE_SECRET_KEY=
# APPSTRUCT_STRIPE_WEBHOOK_SECRET=
# APPSTRUCT_STRIPE_PRICE_PRO=
# APPSTRUCT_STRIPE_PRICE_CREDITS=
# APPSTRUCT_CREDIT_PACK_UNITS=100
# APPSTRUCT_MONTHLY_FREE_CREDITS=20
# APPSTRUCT_MONTHLY_PAID_CREDITS=200
# APPSTRUCT_TEAM_SEAT_LIMIT=0
# APPSTRUCT_TEAM_PAID_SEAT_LIMIT=0
# APPSTRUCT_DAILY_VISIT_EVENT_LIMIT=100000
# APPSTRUCT_PUBLIC_SITE_URL=https://your-domain.example
# APPSTRUCT_AI_ENABLED=true
# APPSTRUCT_AI_MODEL=your-installed-model
