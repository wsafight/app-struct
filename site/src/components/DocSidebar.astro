---
import {groupedPages, href} from '../catalog';
import {ui, type Lang} from '../i18n';

interface Props {
  current?: string;
  lang: Lang;
}

const {current, lang} = Astro.props;
const text = ui[lang];
---
<nav class="docs-sidebar" aria-label={text.docsNav}>
  <details class="docs-nav-panel">
    <summary>{text.browseDocs}</summary>
    <div class="docs-nav-groups">
      {groupedPages.map(group => (
        <section class="docs-group">
          <h2>{group.number} / {group.label[lang]}</h2>
          {group.pages.map(page => (
            <a href={href(page.slug, lang)} aria-current={page.slug === current ? 'page' : undefined}>
              {page.title[lang]}
            </a>
          ))}
        </section>
      ))}
    </div>
  </details>
</nav>
