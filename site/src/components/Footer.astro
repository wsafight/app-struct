---
import BrandMark from './BrandMark.astro';
import {href} from '../catalog';
import {githubRepo, ui, type Lang} from '../i18n';

interface Props { lang: Lang; }
const {lang} = Astro.props;
const text = ui[lang];
const homeHref = href('', lang);
---
<footer class="site-footer">
  <div class="section-inner footer-layout">
    <div class="footer-brand">
      <div class="footer-signature"><BrandMark size={28} /><strong>AppStruct</strong></div>
      <p>
        {lang === 'zh'
          ? '面向 AI Coding Agent 与存量 PostgreSQL 的确定性全栈编译器。'
          : 'The deterministic full-stack compiler for AI coding agents and PostgreSQL admin apps.'}
      </p>
      <p class="footer-legal">© 2026 AppStruct contributors · MIT OR Apache-2.0 · v0.2.0</p>
    </div>
    <nav class="footer-nav" aria-label={text.footerNav}>
      <a href={`${homeHref}#compiler`}>{text.compiler}</a>
      <a href={`${homeHref}#runtime`}>{text.runtime}</a>
      <a href={`${homeHref}#modules`}>{text.modules}</a>
      <a href={`${homeHref}#delivery`}>{text.delivery}</a>
    </nav>
    <nav class="footer-nav" aria-label={lang === 'zh' ? '资源' : 'Resources'}>
      <a href={href('docs', lang)}>{text.docs}</a>
      <a href={href('start/overview', lang)}>{text.quickStart}</a>
      <a href={href('project/roadmap', lang)}>{lang === 'zh' ? '路线图' : 'Roadmap'}</a>
      <a href={githubRepo} target="_blank" rel="noopener noreferrer">{text.github}</a>
    </nav>
  </div>
</footer>
