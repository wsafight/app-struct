---
import Search from '@lucide/astro/icons/search';
import Sun from '@lucide/astro/icons/sun';
import Moon from '@lucide/astro/icons/moon';
import BrandMark from './BrandMark.astro';
import {href} from '../catalog';
import {githubRepo, ui, type Lang} from '../i18n';

interface Props {
  home?: boolean;
  lang: Lang;
  altHref: string;
}

const {home = false, lang, altHref} = Astro.props;
const text = ui[lang];
const homeHref = href('', lang);
const docsHref = href('docs', lang);
const startHref = href('start/overview', lang);
const nav = [
  {href: `${homeHref}#compiler`, label: text.compiler},
  {href: `${homeHref}#runtime`, label: text.runtime},
  {href: `${homeHref}#modules`, label: text.modules},
  {href: `${homeHref}#delivery`, label: text.delivery},
  {href: docsHref, label: text.docs, current: !home},
  {href: githubRepo, label: text.github, external: true},
];
---
<a class="skip-link" href="#main-content">{text.skip}</a>
<header class="site-header" id="site-header" data-header-theme={home ? 'dark' : undefined}>
  <div class="site-header-inner">
    <a class="brand-link" href={homeHref} aria-label={text.home}>
      <BrandMark />
      <span class="brand-name">AppStruct</span>
    </a>
    <nav class="desktop-nav" aria-label={text.primaryNav}>
      {nav.map(item => (
        <a
          href={item.href}
          aria-current={item.current ? 'page' : undefined}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
        >{item.label}</a>
      ))}
      <span class="nav-indicator" aria-hidden="true"></span>
    </nav>
    <div class="header-actions">
      <button class="search-trigger" type="button" data-search-open aria-haspopup="dialog" aria-controls="search-dialog" aria-label={text.search}>
        <Search size={15} stroke-width={1.9} />
        <span class="search-trigger-label">{text.search}</span>
        <kbd class="search-kbd">⌘K</kbd>
      </button>
      <button class="icon-button" type="button" data-theme-toggle aria-label={text.theme}>
        <Sun class="icon-sun" size={17} stroke-width={1.75} />
        <Moon class="icon-moon" size={17} stroke-width={1.75} />
      </button>
      <a class="icon-button language-toggle" href={altHref} aria-label={text.lang} hreflang={lang === 'zh' ? 'en' : 'zh-CN'}>
        {text.langLabel}
      </a>
      <a class="nav-cta" href={startHref}>{text.quickStart}</a>
      <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label={text.menuOpen}>
        <span></span><span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <nav aria-label={text.mobileNav}>
    {nav.map(item => (
      <a
        href={item.href}
        target={item.external ? '_blank' : undefined}
        rel={item.external ? 'noopener noreferrer' : undefined}
      >{item.label}</a>
    ))}
    <a href={startHref}>{text.quickStart}</a>
    <a href={altHref} hreflang={lang === 'zh' ? 'en' : 'zh-CN'}>{text.lang} ({text.langLabel})</a>
  </nav>
</div>
