---
import {ui, type Lang} from '../i18n';

interface Props { lang: Lang; }
const {lang} = Astro.props;
const text = ui[lang];
const pagefindUrl = `${import.meta.env.BASE_URL}pagefind/pagefind.js`;
---
<dialog class="search-dialog" id="search-dialog" aria-labelledby="search-title" data-pagefind-url={pagefindUrl}>
  <form class="search-panel" method="dialog" data-search-root>
    <h2 id="search-title" class="visually-hidden">{text.searchDocs}</h2>
    <input
      type="search"
      name="q"
      placeholder={text.searchDocs}
      aria-label={text.searchDocs}
      data-search-input
      autocomplete="off"
    />
    <div class="search-results" data-search-results></div>
    <p class="search-empty" data-search-empty hidden>{text.searchEmpty}</p>
  </form>
</dialog>
