---
import {ui} from '../i18n';
import T from './T.astro';
interface Heading { depth: number; slug: string; text: string; }
interface Props { headings: Heading[]; lang: 'en' | 'zh'; }
const {headings, lang} = Astro.props;
const items = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---
{items.length > 0 && (
  <nav class:list={['docs-toc', `i18n-${lang}`]} aria-label={ui.en.toc} data-i18n-aria="toc">
    <h2><T en={ui.en.toc} zh={ui.zh.toc} /></h2>
    {items.map(heading => <a href={`#${heading.slug}`} class:list={{'toc-child': heading.depth === 3}}>{heading.text}</a>)}
  </nav>
)}
