---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import {switchLangHref} from '../catalog';
import type {Lang} from '../i18n';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  home?: boolean;
}

const {title, description, lang = 'en', home = false} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const enHref = switchLangHref(Astro.url.pathname, 'en');
const zhHref = switchLangHref(Astro.url.pathname, 'zh');
const enUrl = new URL(enHref, Astro.site);
const zhUrl = new URL(zhHref, Astro.site);
const altHref = lang === 'zh' ? enHref : zhHref;
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} data-lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090c0a" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="AppStruct" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <script is:inline>
      (() => {
        const readStorage = (key) => { try { return localStorage.getItem(key); } catch { return null; } };
        const stored = readStorage('appstruct-theme');
        const theme = stored === 'light' || stored === 'dark' ? stored : (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme;
        const themeMeta = document.querySelector('meta[name="theme-color"]');
        if (themeMeta) themeMeta.setAttribute('content', theme === 'light' ? '#f6f5f0' : '#090c0a');
      })();
    </script>
  </head>
  <body class={home ? 'home' : 'docs-body'}>
    <Header home={home} lang={lang} altHref={altHref} />
    <SearchDialog lang={lang} />
    <slot />
    <Footer lang={lang} />
    <script>import '../scripts/site.ts';</script>
  </body>
</html>
