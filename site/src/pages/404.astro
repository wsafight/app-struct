---
import Base from '../layouts/Base.astro';
import BracketLink from '../components/BracketLink.astro';
import T from '../components/T.astro';
import {href} from '../catalog';
import {pagesMeta} from '../i18n';
import '../styles/home.css';
---
<Base title={pagesMeta.notFound.title.en} titleZh={pagesMeta.notFound.title.zh} description={pagesMeta.notFound.description.en} descriptionZh={pagesMeta.notFound.description.zh}>
  <main id="main-content" class="not-found">
    <div class="section-inner">
      <p class="eyebrow">404 / NOT IN THE GRAPH</p>
      <h1><T en="Page not found" zh="找不到这个页面" /></h1>
      <p><T en="The page may have moved, or the URL may be incorrect." zh="页面可能已移动，也可能是网址有误。" /></p>
      <BracketLink href={href()}><T en="Back to AppStruct" zh="返回 AppStruct" /></BracketLink>
    </div>
  </main>
</Base>
