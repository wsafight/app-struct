---
import Base from '../layouts/Base.astro';
import {href} from '../catalog';
import {pagesMeta} from '../i18n';
import '../styles/home.css';
---
<Base title={pagesMeta.notFound.title.en} description={pagesMeta.notFound.description.en} lang="en">
  <main id="main-content" class="not-found">
    <div class="section-inner not-found-inner">
      <p class="eyebrow">404 / NOT IN THE GRAPH</p>
      <h1>Page not found</h1>
      <p>The page may have moved, or the URL may be incorrect.</p>
      <div class="not-found-actions">
        <a class="btn-primary" href={href('', 'en')}>Back to English Home</a>
        <a class="btn-secondary" href={href('', 'zh')}>返回中文首页</a>
      </div>
    </div>
  </main>
</Base>
