---
import {getCollection, type CollectionEntry} from 'astro:content';
import DocArticlePage from '../components/DocArticlePage.astro';
import {pages, type DocPage} from '../catalog';

export async function getStaticPaths() {
  const docsEn = await getCollection('docsEn');
  return pages.map(page => {
    const entry = docsEn.find(item => item.id === page.slug);
    if (!entry) throw new Error(`Missing English documentation entry for ${page.source}`);
    return {params: {slug: page.slug}, props: {page, entry}};
  });
}

interface Props {
  page: DocPage;
  entry: CollectionEntry<'docsEn'>;
}

const {page, entry} = Astro.props;
---
<DocArticlePage lang="en" page={page} entry={entry} />
