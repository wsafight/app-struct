---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Box from '@lucide/astro/icons/box';
import Database from '@lucide/astro/icons/database';
import FileCode2 from '@lucide/astro/icons/file-code';
import Gauge from '@lucide/astro/icons/gauge';
import Layers3 from '@lucide/astro/icons/layers';
import LockKeyhole from '@lucide/astro/icons/lock-keyhole';
import Radio from '@lucide/astro/icons/radio';
import RefreshCw from '@lucide/astro/icons/refresh-cw';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import TerminalSquare from '@lucide/astro/icons/square-terminal';
import Webhook from '@lucide/astro/icons/webhook';
import Base from '../layouts/Base.astro';
import BracketLink from '../components/BracketLink.astro';
import T from '../components/T.astro';
import {href} from '../catalog';
import {pagesMeta} from '../i18n';
import '../styles/home.css';

const startHref = href('start/overview');
const docsHref = href('docs');
---
<Base title={pagesMeta.home.title.en} titleZh={pagesMeta.home.title.zh} description={pagesMeta.home.description.en} descriptionZh={pagesMeta.home.description.zh} home>
  <main id="main-content">
    <section class="hero" id="top">
      <div class="hero-graph" aria-hidden="true">
        <div class="graph-axis graph-axis-x"></div>
        <div class="graph-axis graph-axis-y"></div>
        <div class="graph-node graph-spec"><FileCode2 size={16} /><span>APP SPEC</span></div>
        <div class="graph-node graph-core"><span>IR</span><i></i></div>
        <div class="graph-node graph-db"><Database size={16} /><span>POSTGRES</span></div>
        <div class="graph-node graph-api"><TerminalSquare size={16} /><span>AXUM API</span></div>
        <div class="graph-node graph-web"><Layers3 size={16} /><span>REACT WEB</span></div>
        <div class="graph-line line-spec"></div>
        <div class="graph-line line-db"></div>
        <div class="graph-line line-api"></div>
        <div class="graph-line line-web"></div>
        <span class="graph-status">VALIDATED / DETERMINISTIC / EXTENSIBLE</span>
      </div>
      <div class="hero-inner section-inner">
        <div class="hero-copy-block">
          <p class="eyebrow"><T en="YAML App Specs for Rust applications." zh="用 YAML App Spec 构建 Rust 应用。" /></p>
          <h1>AppStruct</h1>
          <p class="hero-statement"><T en="Compile an App Spec into a type-safe Rust application stack." zh="将 App Spec 编译为类型安全的 Rust 应用栈。" /></p>
        </div>
        <div class="hero-bottom">
          <div class="hero-cta">
            <BracketLink href={startHref}><T en="Build your first app" zh="构建第一个应用" /></BracketLink>
            <a class="text-link" href={docsHref}><T en="Browse the documentation" zh="查看文档" /></a>
          </div>
          <p><T en="AppStruct generates a typed IR, PostgreSQL migrations, an Axum backend, OpenAPI, a TypeScript client, and a React operations UI from YAML. Keep custom Rust and TypeScript extensions separate from generated files." zh="AppStruct 会从 YAML 生成类型化 IR、PostgreSQL 迁移、Axum 后端、OpenAPI、TypeScript 客户端和 React 管理界面。自定义 Rust 与 TypeScript 扩展独立维护，不会混入生成文件。" /></p>
        </div>
      </div>
    </section>

    <section class="compiler-section light-section" id="compiler">
      <div class="section-inner">
        <div class="section-heading split-heading">
          <div>
            <p class="eyebrow"><T en="01 / The application compiler" zh="01 / 应用编译器" /></p>
            <h2><T en="Define the app in YAML.<br>Generate each layer from one IR." zh="用 YAML 定义应用。<br>各层由同一份 IR 生成。" /></h2>
          </div>
          <p class="section-lede"><T en="Every generator reads the same normalized IR, so the database schema, permissions, API, and UI follow the same definitions." zh="所有生成器都读取同一份规范化 IR，数据库 Schema、权限、API 和界面因此遵循同一套定义。" /></p>
        </div>
        <div class="capability-panels">
          <article class="capability-panel is-active">
            <button class="capability-trigger" type="button">
              <span>01</span><strong><T en="Spec validation" zh="Spec 校验" /></strong>
            </button>
            <p><T en="AppStruct checks references, access rules, field options, workflows, and module contracts. Diagnostics point to the source." zh="AppStruct 会检查引用、访问规则、字段选项、工作流和模块契约，并在诊断中标出源码位置。" /></p>
          </article>
          <article class="capability-panel">
            <button class="capability-trigger" type="button">
              <span>02</span><strong><T en="One typed IR" zh="单一类型化 IR" /></strong>
            </button>
            <p><T en="Database migrations, backend, OpenAPI, client, and UI manifest are derived from one typed intermediate representation." zh="数据库迁移、后端、OpenAPI、客户端和 UI Manifest 都由同一份类型化中间表示生成。" /></p>
          </article>
          <article class="capability-panel">
            <button class="capability-trigger" type="button">
              <span>03</span><strong><T en="Tracked generated files" zh="追踪生成文件" /></strong>
            </button>
            <p><T en="Content-addressed manifests track generated files. Regeneration leaves user-owned Rust and React extensions outside the overwrite boundary." zh="内容寻址清单追踪生成文件；重新生成时，不会覆盖用户维护的 Rust 和 React 扩展。" /></p>
          </article>
          <article class="capability-panel">
            <button class="capability-trigger" type="button">
              <span>04</span><strong><T en="Review schema diffs" zh="审查 Schema 差异" /></strong>
            </button>
            <p><T en="Schema diffs classify destructive and locking work before migration files or production data can change." zh="Schema Diff 会在迁移文件或生产数据变更前识别破坏性与锁表操作。" /></p>
          </article>
        </div>
      </div>
    </section>

    <section class="spec-section dark-section">
      <div class="section-inner spec-layout">
        <div class="section-heading">
          <p class="eyebrow"><T en="02 / App Spec to artifacts" zh="02 / 从 App Spec 到产物" /></p>
          <h2><T en="Start with an App Spec.<br>Generate the application layers." zh="从 App Spec 开始。<br>生成应用各层。" /></h2>
          <p class="section-lede"><T en="Define an entity and its access rules, then enable modules as needed. AppStruct uses the spec to generate the database, API, client, and UI." zh="先定义实体和访问规则，再按需启用模块。AppStruct 会依据这份 Spec 生成数据库、API、客户端与界面。" /></p>
        </div>
        <div class="code-workbench">
          <div class="workbench-tabs"><span class="is-current">spec/work.yaml</span><span>appstruct.yaml</span></div>
          <pre><code><span class="code-key">entities</span>:
  <span class="code-name">Project</span>:
    <span class="code-key">tenant</span>: <span class="code-value">true</span>
    <span class="code-key">audit</span>: <span class="code-value">true</span>
    <span class="code-key">fields</span>:
      <span class="code-name">name</span>: &#123; <span class="code-key">type</span>: string, <span class="code-key">required</span>: <span class="code-value">true</span> &#125;
      <span class="code-name">status</span>:
        <span class="code-key">type</span>: enum
        <span class="code-key">values</span>: [planned, active, done]
    <span class="code-key">access</span>:
      <span class="code-key">read</span>: [member, admin]
      <span class="code-key">write</span>: [admin]</code></pre>
          <div class="build-log">
            <span><i class="status-ok"></i>check</span>
            <span><i class="status-ok"></i>typed IR v11</span>
            <span><i class="status-ok"></i>7 artifacts</span>
            <strong>518 ms</strong>
          </div>
        </div>
      </div>
    </section>

    <section class="runtime-section light-section" id="runtime">
      <div class="section-inner runtime-layout">
        <div class="runtime-copy">
          <p class="eyebrow"><T en="03 / Generated operations UI" zh="03 / 生成的业务管理界面" /></p>
          <h2><T en="Generated UI for common tasks.<br>Ready for custom workflows." zh="生成常用业务界面，<br>也可扩展自定义流程。" /></h2>
          <ul class="feature-list">
            <li><strong><T en="Access is enforced on the server" zh="权限由服务端执行" /></strong><span><T en="Actor, tenant, field, and record policies are checked before data reaches the UI." zh="数据返回界面前，服务端会检查 Actor、租户、字段和记录级 Policy。" /></span></li>
            <li><strong><T en="Shared resource behavior" zh="统一的资源行为" /></strong><span><T en="Lists, filters, forms, relations, workflows, bulk actions, and activity use one resource contract." zh="列表、筛选、表单、关联、工作流、批量操作和动态记录共用一套资源契约。" /></span></li>
            <li><strong><T en="Extend without editing generated code" zh="扩展业务而不改生成代码" /></strong><span><T en="Add commands, queries, Rust handlers, and React registry entries alongside the generated baseline." zh="通过 Command、Query、Rust Handler 和 React Registry 增加业务逻辑，无需修改生成物。" /></span></li>
          </ul>
        </div>
        <div class="app-preview" aria-label="Generated AppStruct operations interface preview">
          <div class="preview-topbar"><span class="preview-mark"><span class="preview-brand-dot"></span>AS</span><span>Northstar Ops</span><div><i></i><i></i><i></i></div></div>
          <div class="preview-body">
            <aside><strong>OPERATIONS</strong><span class="active">Overview</span><span>Projects</span><span>Tasks</span><span>Audit</span><span>Jobs</span></aside>
            <div class="preview-main">
              <div class="preview-title"><div><small>Workspace</small><strong>Projects</strong></div><button type="button">+ New project</button></div>
              <div class="preview-metrics"><span><small>ACTIVE</small><strong>18</strong></span><span><small>DUE THIS WEEK</small><strong>7</strong></span><span><small>AT RISK</small><strong class="risk">2</strong></span></div>
              <div class="preview-toolbar"><span>Search projects</span><b>All statuses</b><b>Owner</b></div>
              <div class="preview-table">
                <div class="preview-row table-head"><span>PROJECT</span><span>STATUS</span><span>OWNER</span><span>UPDATED</span></div>
                <div class="preview-row"><span><i class="row-dot green"></i>Atlas migration</span><span><em class="active-status">Active</em></span><span>M. Chen</span><span>12 min</span></div>
                <div class="preview-row"><span><i class="row-dot amber"></i>Partner portal</span><span><em>Planned</em></span><span>A. Shah</span><span>2 hr</span></div>
                <div class="preview-row"><span><i class="row-dot green"></i>Billing audit</span><span><em class="active-status">Active</em></span><span>L. Wang</span><span>Yesterday</span></div>
                <div class="preview-row"><span><i class="row-dot red"></i>Q4 reporting</span><span><em class="blocked-status">Blocked</em></span><span>S. Ito</span><span>Aug 28</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="modules-section dark-section" id="modules">
      <div class="section-inner">
        <div class="section-heading split-heading">
          <div>
            <p class="eyebrow"><T en="04 / Platform modules" zh="04 / 平台模块" /></p>
            <h2><T en="Add platform modules<br>as your app needs them." zh="按需启用<br>平台模块。" /></h2>
          </div>
          <p class="section-lede"><T en="Each module is wired into the migration plan, runtime, OpenAPI contract, and generated UI." zh="每个模块都会接入迁移计划、运行时、OpenAPI 契约和生成界面。" /></p>
        </div>
        <div class="module-grid">
          <article><ShieldCheck size={21} /><strong><T en="Auth + RBAC" zh="认证 + RBAC" /></strong><span><T en="Sessions, CSRF, roles, field access" zh="会话、CSRF、角色、字段权限" /></span></article>
          <article><Layers3 size={21} /><strong><T en="Tenant" zh="租户" /></strong><span><T en="Memberships, invites, isolation" zh="成员关系、邀请、数据隔离" /></span></article>
          <article><RefreshCw size={21} /><strong><T en="Jobs" zh="后台任务" /></strong><span><T en="Durable work, retry, replay" zh="持久任务、重试、重放" /></span></article>
          <article><Webhook size={21} /><strong><T en="Webhooks" zh="Webhook" /></strong><span><T en="Signed delivery and outbox" zh="签名投递与 Outbox" /></span></article>
          <article><Radio size={21} /><strong><T en="Realtime" zh="实时能力" /></strong><span><T en="SSE, presence, edit leases" zh="SSE、在线状态、编辑租约" /></span></article>
          <article><Box size={21} /><strong><T en="Files + Mail" zh="文件 + 邮件" /></strong><span><T en="Provider boundaries, local capture" zh="Provider 边界、本地捕获" /></span></article>
          <article><Gauge size={21} /><strong><T en="Admin" zh="运维控制台" /></strong><span><T en="Health, queues, recovery" zh="健康、队列、恢复操作" /></span></article>
          <article><LockKeyhole size={21} /><strong><T en="Audit" zh="审计" /></strong><span><T en="Transactional snapshots and activity" zh="事务化快照与记录动态" /></span></article>
        </div>
      </div>
    </section>

    <section class="delivery-section light-section" id="delivery">
      <div class="section-inner delivery-layout">
        <div>
          <p class="eyebrow"><T en="05 / Development to production" zh="05 / 从开发到生产" /></p>
          <h2><T en="Make each release<br>step explicit." zh="明确每个<br>发布步骤。" /></h2>
        </div>
        <ol class="delivery-steps">
          <li><span>01</span><div><strong><T en="Start the development stack" zh="启动开发环境" /></strong><p><T en="One command coordinates PostgreSQL, generation, the Rust API, and Rsbuild, then cleans up the complete process tree." zh="一条命令协调 PostgreSQL、生成、Rust API 与 Rsbuild，并完整清理进程树。" /></p></div></li>
          <li><span>02</span><div><strong><T en="Review the database plan" zh="审查数据库计划" /></strong><p><T en="Plan and lint are read-only. Risky changes stop before SQL is accepted or applied." zh="Plan 与 Lint 保持只读；高风险变更在 SQL 被接受或应用前停止。" /></p></div></li>
          <li><span>03</span><div><strong><T en="Ship immutable artifacts" zh="交付不可变产物" /></strong><p><T en="Production startup never migrates implicitly. Status and apply run as a dedicated release job." zh="生产启动永不隐式迁移；Status 与 Apply 在独立发布任务中执行。" /></p></div></li>
        </ol>
      </div>
    </section>

    <section class="final-cta dark-section">
      <div class="section-inner final-layout">
        <div>
          <p class="eyebrow">APPSTRUCT / TECHNICAL PREVIEW / 0.2.0</p>
          <h2><T en="Create a project.<br>Extend it with AppStruct." zh="创建项目。<br>再用 AppStruct 扩展。" /></h2>
        </div>
        <div class="final-action">
          <p><T en="Build the CLI from the pinned workspace, create a dashboard project, and add app-specific behavior in Rust or TypeScript." zh="从锁定版本的工作区构建 CLI，创建 Dashboard 项目，再用 Rust 或 TypeScript 编写应用自己的业务逻辑。" /></p>
          <BracketLink href={startHref}><T en="Open the quick start" zh="打开快速开始" /> <ArrowRight size={15} /></BracketLink>
          <span>Rust 1.99 · PostgreSQL 17 · React 19 · Node 24</span>
        </div>
      </div>
    </section>
  </main>
</Base>
