---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Box from '@lucide/astro/icons/box';
import Database from '@lucide/astro/icons/database';
import FileCode2 from '@lucide/astro/icons/file-code';
import Gauge from '@lucide/astro/icons/gauge';
import Layers3 from '@lucide/astro/icons/layers';
import LockKeyhole from '@lucide/astro/icons/lock-keyhole';
import Radio from '@lucide/astro/icons/radio';
import RefreshCw from '@lucide/astro/icons/refresh-cw';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import TerminalSquare from '@lucide/astro/icons/square-terminal';
import Webhook from '@lucide/astro/icons/webhook';
import Base from '../layouts/Base.astro';
import BracketLink from '../components/BracketLink.astro';
import T from '../components/T.astro';
import {href} from '../catalog';
import {pagesMeta} from '../i18n';
import '../styles/home.css';

const startHref = href('start/overview');
const docsHref = href('docs');
const existingDbHref = href('start/existing-database');
---
<Base title={pagesMeta.home.title.en} titleZh={pagesMeta.home.title.zh} description={pagesMeta.home.description.en} descriptionZh={pagesMeta.home.description.zh} home>
  <main id="main-content">
    <section class="hero" id="top">
      <div class="hero-graph" aria-hidden="true">
        <div class="graph-axis graph-axis-x"></div>
        <div class="graph-axis graph-axis-y"></div>
        <div class="graph-node graph-spec"><FileCode2 size={16} /><span>YAML / MCP</span></div>
        <div class="graph-node graph-core"><span>IR</span><i></i></div>
        <div class="graph-node graph-db"><Database size={16} /><span>POSTGRES + RLS</span></div>
        <div class="graph-node graph-api"><TerminalSquare size={16} /><span>AXUM API</span></div>
        <div class="graph-node graph-web"><Layers3 size={16} /><span>REACT 19 UI</span></div>
        <div class="graph-line line-spec"></div>
        <div class="graph-line line-db"></div>
        <div class="graph-line line-api"></div>
        <div class="graph-line line-web"></div>
        <span class="graph-status">FAIL-CLOSED / DETERMINISTIC / MCP-READY</span>
      </div>
      <div class="hero-inner section-inner">
        <div class="hero-copy-block">
          <p class="eyebrow"><T en="Deterministic Full-Stack Compiler · Built-in MCP Server" zh="确定性全栈编译器 · 内置 MCP Server" /></p>
          <h1>AppStruct</h1>
          <p class="hero-statement"><T en="Compile YAML specs into a fail-closed Rust + React stack." zh="将 YAML 规格编译为默认拒绝的 Rust + React 全栈应用。" /></p>
        </div>
        <div class="hero-cli" data-cli-strip>
          <div class="hero-cli-tabs" role="tablist" aria-label="Quick start commands">
            <button type="button" role="tab" aria-selected="true" class="is-current" data-cli-tab="demo"><T en="Live Demo" zh="一键 Demo" /></button>
            <button type="button" role="tab" aria-selected="false" data-cli-tab="db"><T en="Existing PostgreSQL" zh="存量数据库" /></button>
            <button type="button" role="tab" aria-selected="false" data-cli-tab="mcp"><T en="AI Agent (MCP)" zh="AI 编程 (MCP)" /></button>
          </div>
          <div class="hero-cli-row">
            <code data-cli-cmd="demo">docker compose -f docker-compose.demo.yaml up --build</code>
            <code data-cli-cmd="db" hidden>appstruct db pull --review &amp;&amp; appstruct access preview --role admin</code>
            <code data-cli-cmd="mcp" hidden>appstruct mcp &amp;&amp; appstruct check --deny-warnings</code>
            <button type="button" class="hero-cli-copy" data-copy-cli><T en="Copy" zh="复制" /></button>
          </div>
        </div>
        <div class="hero-bottom">
          <div class="hero-cta">
            <BracketLink href={startHref}><T en="Build your first app" zh="构建第一个应用" /></BracketLink>
            <a class="text-link" href={existingDbHref}><T en="Introspect PostgreSQL" zh="接入存量数据库" /></a>
            <a class="text-link" href={docsHref}><T en="Browse docs" zh="查看文档" /></a>
          </div>
          <p><T en="Built for AI coding agents and engineering teams alike. Write declarative YAML—without needing to master Rust—to compile PostgreSQL migrations with RLS, a fail-closed Axum backend, OpenAPI, a TypeScript client, and a React 19 operations UI." zh="同时面向 AI Coding Agent 与研发团队。只需编写声明式 YAML（无需精通 Rust），即可确定性编译出带 RLS 的 PostgreSQL 迁移、默认拒绝的 Axum 后端、OpenAPI、TypeScript 客户端与 React 19 管理界面。" /></p>
        </div>
      </div>
    </section>

    <section class="compiler-section light-section" id="compiler">
      <div class="section-inner">
        <div class="section-heading split-heading">
          <div>
            <p class="eyebrow"><T en="01 / The application compiler" zh="01 / 应用编译器" /></p>
            <h2><T en="Define the app in YAML.<br>Generate each layer from one IR." zh="用 YAML 定义应用。<br>各层由同一份 IR 生成。" /></h2>
          </div>
          <p class="section-lede"><T en="Turn full-stack CRUD, authorization, and migrations into a verifiable compiler loop. Every generator reads the same normalized IR so schema, policies, API, and UI never drift." zh="将全栈 CRUD、权限控制与数据库迁移变成可静态验证的编译闭环。所有生成器共用同一份规范化 IR，Schema、权限策略、API 与前端界面永不漂移。" /></p>
        </div>
        <div class="capability-panels">
          <article class="capability-panel is-active">
            <button class="capability-trigger" type="button">
              <span>01</span><strong><T en="Spec + MCP validation" zh="Spec 与 MCP 校验" /></strong>
            </button>
            <div class="capability-body">
              <p><T en="Built-in stdio MCP server and Draft 2020-12 JSON Schema validate references, RBAC, tenant isolation, workflows, and module contracts with source-pinned diagnostics." zh="内置零依赖 stdio MCP Server 与 Draft 2020-12 JSON Schema，静态校验引用、RBAC、租户隔离、工作流与模块契约，精确报错到源码行列。" /></p>
              <code class="capability-badge">appstruct mcp · check --deny-warnings</code>
            </div>
          </article>
          <article class="capability-panel">
            <button class="capability-trigger" type="button">
              <span>02</span><strong><T en="Typed IR + impact" zh="类型化 IR 与影响分析" /></strong>
            </button>
            <div class="capability-body">
              <p><T en="Database migrations, Rust API, OpenAPI, client SDK, and UI manifest derive from one IR. Query the static dependency graph before changing any entity, field, or role." zh="迁移脚本、Rust API、OpenAPI、客户端 SDK 与 UI 清单均由单一 IR 派生；修改实体、字段或角色前可静态追踪全链路影响面。" /></p>
              <code class="capability-badge">appstruct impact · access preview</code>
            </div>
          </article>
          <article class="capability-panel">
            <button class="capability-trigger" type="button">
              <span>03</span><strong><T en="Tracked boundary" zh="不可变生成边界" /></strong>
            </button>
            <div class="capability-body">
              <p><T en="SHA-256 content-addressed manifests track generated files with atomic replacement. Custom Rust handlers and React registry entries live cleanly outside generated/." zh="SHA-256 内容寻址清单追踪生成物并原子替换；自定义 Rust Handler 与 React Registry 独立维护，重新生成绝不覆盖业务代码。" /></p>
              <code class="capability-badge">generated/ · SHA-256 manifest</code>
            </div>
          </article>
          <article class="capability-panel">
            <button class="capability-trigger" type="button">
              <span>04</span><strong><T en="Safe online migrations" zh="安全在线迁移" /></strong>
            </button>
            <div class="capability-body">
              <p><T en="Forward-only schema diffs block destructive and locking DDL before SQL is applied. Existing PostgreSQL databases onboard cleanly via interactive db pull and baseline." zh="向前兼容的 Schema Diff 在执行前拦截破坏性与锁表 DDL；存量 PostgreSQL 可通过交互式 db pull 与 baseline 平滑纳管。" /></p>
              <code class="capability-badge">db pull --review · migrate lint</code>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="spec-section dark-section">
      <div class="section-inner spec-layout">
        <div class="section-heading">
          <p class="eyebrow"><T en="02 / App Spec to artifacts" zh="02 / 从 App Spec 到产物" /></p>
          <h2><T en="Start with an App Spec.<br>Verify before shipping." zh="从 App Spec 开始。<br>交付前先静态验证。" /></h2>
          <p class="section-lede"><T en="Declare entities, auto-numbering, tenant RLS, and role rules in YAML. Inspect permission matrices and cross-layer impact before generating a single line of runtime code." zh="用 YAML 声明实体、自动编号、租户 RLS 与角色权限。在生成运行时代码前，即可预演权限矩阵与跨层变更影响。" /></p>
        </div>
        <div class="code-workbench" data-workbench>
          <div class="workbench-head">
            <div class="workbench-tabs" role="tablist" aria-label="App Spec files">
              <button type="button" role="tab" aria-selected="true" class="is-current" data-workbench-tab="work">spec/work.yaml</button>
              <button type="button" role="tab" aria-selected="false" data-workbench-tab="app">appstruct.yaml</button>
              <button type="button" role="tab" aria-selected="false" data-workbench-tab="impact">impact + preview</button>
            </div>
            <button type="button" class="workbench-copy" data-workbench-copy><T en="Copy" zh="复制" /></button>
          </div>
          <pre data-workbench-panel="work"><code><span class="code-key">entities</span>:
  <span class="code-name">Project</span>:
    <span class="code-key">tenant</span>: <span class="code-value">true</span>
    <span class="code-key">audit</span>: <span class="code-value">true</span>
    <span class="code-key">fields</span>:
      <span class="code-name">doc_no</span>: &#123; <span class="code-key">type</span>: string, <span class="code-key">generated</span>: auto_number &#125;
      <span class="code-name">name</span>: &#123; <span class="code-key">type</span>: string, <span class="code-key">required</span>: <span class="code-value">true</span> &#125;
      <span class="code-name">status</span>:
        <span class="code-key">type</span>: enum
        <span class="code-key">values</span>: [planned, active, done]
    <span class="code-key">access</span>:
      <span class="code-key">read</span>: [member, admin]
      <span class="code-key">write</span>: [admin]</code></pre>
          <pre data-workbench-panel="app" hidden><code><span class="code-key">app</span>:
  <span class="code-key">name</span>: <span class="code-value">northstar-ops</span>
<span class="code-key">database</span>:
  <span class="code-key">provider</span>: <span class="code-value">postgres</span>
<span class="code-key">modules</span>:
  <span class="code-key">auth</span>: &#123; <span class="code-key">enabled</span>: <span class="code-value">true</span>, <span class="code-key">user_entity</span>: User &#125;
  <span class="code-key">tenant</span>: &#123; <span class="code-key">enabled</span>: <span class="code-value">true</span>, <span class="code-key">rls</span>: <span class="code-value">true</span> &#125;
  <span class="code-key">audit</span>: &#123; <span class="code-key">enabled</span>: <span class="code-value">true</span> &#125;
  <span class="code-key">report</span>: &#123; <span class="code-key">enabled</span>: <span class="code-value">true</span> &#125;
<span class="code-key">includes</span>:
  - <span class="code-value">spec/work.yaml</span></code></pre>
          <pre data-workbench-panel="impact" hidden><code><span class="code-muted">$ appstruct impact --entity Project --format text</span>
<span class="code-key">Entity</span>  <span class="code-name">Project</span>  (tenant: <span class="code-value">rls</span>, audit: <span class="code-value">on</span>, auto_number: <span class="code-value">doc_no</span>)
  ├─ <span class="code-key">Tables</span>   projects, _appstruct_number_sequences
  ├─ <span class="code-key">Routes</span>   GET/POST /api/projects, PATCH/DELETE /api/projects/:id
  ├─ <span class="code-key">Reports</span>  active_projects_by_status (readiness: <span class="code-value">ok</span>)
  └─ <span class="code-key">Access</span>   member: read · admin: read, create, update, delete

<span class="code-muted">$ appstruct check --deny-warnings</span>
<span class="code-key">ok</span>  0 errors · 0 warnings · fail-closed policy verified</code></pre>
          <div class="build-log">
            <span><i class="status-ok"></i>check</span>
            <span><i class="status-ok"></i>typed IR + impact</span>
            <span><i class="status-ok"></i>7 artifacts</span>
            <strong>518 ms</strong>
          </div>
        </div>
      </div>
    </section>

    <section class="runtime-section light-section" id="runtime">
      <div class="section-inner runtime-layout">
        <div class="runtime-copy">
          <p class="eyebrow"><T en="03 / Generated operations UI" zh="03 / 生成的业务管理界面" /></p>
          <h2><T en="Generated UI for common tasks.<br>Ready for custom workflows." zh="生成常用业务界面，<br>也可扩展自定义流程。" /></h2>
          <ul class="feature-list">
            <li><strong><T en="Fail-closed enforcement + PostgreSQL RLS" zh="默认拒绝权限校验 + PostgreSQL RLS" /></strong><span><T en="Actor, tenant lifecycle, PostgreSQL row-level security, field, and record policies are enforced before data leaves the server." zh="数据离开服务端前，严格校验 Actor、租户生命周期状态、PostgreSQL 行级安全（RLS）、字段与记录级 Policy。" /></span></li>
            <li><strong><T en="Complete operations toolkit out of the box" zh="开箱即用的企业运维交互" /></strong><span><T en="Auto-numbered document codes, saved views, nested filters, bulk actions, CSV import/export, optimistic concurrency, and field-level audit diffs." zh="内置单据自动编号、已保存视图、嵌套筛选、批量操作、导入导出、乐观锁并发控制与字段级审计差异历史。" /></span></li>
            <li><strong><T en="Extend without touching generated code" zh="零侵入扩展业务逻辑" /></strong><span><T en="Add typed commands, queries, Rust handlers, and React registry entries alongside the generated baseline." zh="通过类型化 Command、Query、Rust Handler 与 React Registry 编写定制业务，无需改动任何生成代码。" /></span></li>
          </ul>
        </div>
        <div class="app-preview" aria-label="Generated AppStruct operations interface preview">
          <div class="preview-topbar">
            <span class="preview-mark"><span class="preview-brand-dot"></span>AS</span>
            <span class="preview-tenant-badge">TENANT: ACME · RLS ON</span>
            <div><i></i><i></i><i></i></div>
          </div>
          <div class="preview-body">
            <aside><strong>OPERATIONS</strong><span class="active">Projects</span><span>Tasks</span><span>Reports</span><span>Audit</span><span>Jobs</span></aside>
            <div class="preview-main">
              <div class="preview-title"><div><small>Northstar Ops · Workspace</small><strong>Projects</strong></div><button type="button">+ New project</button></div>
              <div class="preview-metrics"><span><small>ACTIVE</small><strong>18</strong></span><span><small>DUE THIS WEEK</small><strong>7</strong></span><span><small>AT RISK</small><strong class="risk">2</strong></span></div>
              <div class="preview-toolbar"><span>Search doc_no or name...</span><b>Status: All</b><b>Saved view</b></div>
              <div class="preview-table">
                <div class="preview-row table-head"><span>DOC NO · PROJECT</span><span>STATUS</span><span>OWNER</span><span>UPDATED</span></div>
                <div class="preview-row"><span><i class="row-dot green"></i><code class="preview-doc-no">PRJ-0018</code> Atlas migration</span><span><em class="active-status">Active</em></span><span>M. Chen</span><span>12 min</span></div>
                <div class="preview-row"><span><i class="row-dot amber"></i><code class="preview-doc-no">PRJ-0017</code> Partner portal</span><span><em>Planned</em></span><span>A. Shah</span><span>2 hr</span></div>
                <div class="preview-row"><span><i class="row-dot green"></i><code class="preview-doc-no">PRJ-0016</code> Billing audit</span><span><em class="active-status">Active</em></span><span>L. Wang</span><span>Yesterday</span></div>
                <div class="preview-row"><span><i class="row-dot red"></i><code class="preview-doc-no">PRJ-0015</code> Q4 reporting</span><span><em class="blocked-status">Blocked</em></span><span>S. Ito</span><span>Aug 28</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="modules-section dark-section" id="modules">
      <div class="section-inner">
        <div class="section-heading split-heading">
          <div>
            <p class="eyebrow"><T en="04 / Platform modules" zh="04 / 平台模块" /></p>
            <h2><T en="Add platform modules<br>as your app needs them." zh="按需启用<br>平台模块。" /></h2>
          </div>
          <p class="section-lede"><T en="Each module compiles directly into PostgreSQL migrations, Rust runtime guards, OpenAPI contracts, and generated operations pages." zh="每个模块都会直接编译进 PostgreSQL 迁移、Rust 运行时守卫、OpenAPI 契约与生成的管理页面。" /></p>
        </div>
        <div class="module-grid">
          <article><ShieldCheck size={21} /><strong><T en="Auth + RBAC" zh="认证 + RBAC" /></strong><span><T en="Sessions, CSRF, OAuth/OIDC, field-level access" zh="会话、CSRF、OAuth/OIDC、字段级权限" /></span></article>
          <article><Layers3 size={21} /><strong><T en="Tenant + RLS" zh="多租户 + RLS" /></strong><span><T en="Memberships, tenant lifecycle, PostgreSQL RLS isolation" zh="成员关系、租户生命周期、PostgreSQL RLS 隔离" /></span></article>
          <article><RefreshCw size={21} /><strong><T en="Jobs + Schedules" zh="后台任务 + 定时调度" /></strong><span><T en="Durable queues, cron schedules, retry, replay" zh="持久队列、Cron 调度、失败重试与重放" /></span></article>
          <article><Webhook size={21} /><strong><T en="Webhooks + Outbox" zh="Webhook + Outbox" /></strong><span><T en="Transactional outbox and signed HTTP delivery" zh="事务性 Outbox 与签名 HTTP 投递" /></span></article>
          <article><Radio size={21} /><strong><T en="Realtime" zh="实时能力" /></strong><span><T en="SSE event streams, presence, edit leases" zh="SSE 事件流、在线状态、编辑租约" /></span></article>
          <article><Box size={21} /><strong><T en="Files + Mail" zh="文件 + 邮件" /></strong><span><T en="Storage provider boundaries and local mail capture" zh="存储 Provider 边界与本地邮件捕获" /></span></article>
          <article><Gauge size={21} /><strong><T en="Reports + Admin" zh="报表 + 运维控制台" /></strong><span><T en="Typed KPI/trend charts, readiness checks, recovery" zh="类型化 KPI/趋势报表、就绪探针与运维恢复" /></span></article>
          <article><LockKeyhole size={21} /><strong><T en="Audit + Activity" zh="审计 + 记录动态" /></strong><span><T en="Transactional snapshots, field diffs, record timeline" zh="事务化快照、字段级差异与记录时间线" /></span></article>
        </div>
      </div>
    </section>

    <section class="delivery-section light-section" id="delivery">
      <div class="section-inner delivery-layout">
        <div>
          <p class="eyebrow"><T en="05 / Development to production" zh="05 / 从开发到生产" /></p>
          <h2><T en="Make each release<br>step explicit." zh="明确每个<br>发布步骤。" /></h2>
        </div>
        <ol class="delivery-steps">
          <li>
            <span>01</span>
            <div>
              <strong><T en="Start locally or via Docker Demo" zh="本地或 Docker 一键启动" /></strong>
              <p><T en="One command coordinates PostgreSQL, code generation, the Rust API, and Rsbuild—or spin up the full multi-tenant SaaS demo with zero host prerequisites." zh="一条命令协调 PostgreSQL、代码生成、Rust API 与 Rsbuild；也可用 Docker Compose 零环境依赖体验完整多租户 SaaS Demo。" /></p>
              <code class="delivery-cmd">appstruct dev</code>
            </div>
          </li>
          <li>
            <span>02</span>
            <div>
              <strong><T en="Review migrations, access &amp; impact" zh="审查迁移、权限与影响面" /></strong>
              <p><T en="Plan, lint, access preview, and impact analysis stay strictly read-only. Destructive DDL or unintended policy regressions stop before SQL is accepted." zh="Plan、Lint、权限预演与影响分析全程只读；破坏性 DDL 或权限回归会在 SQL 接受前被拦截。" /></p>
              <code class="delivery-cmd">appstruct migrate lint --deny-warnings &amp;&amp; appstruct impact</code>
            </div>
          </li>
          <li>
            <span>03</span>
            <div>
              <strong><T en="Ship immutable verified artifacts" zh="交付不可变可校验产物" /></strong>
              <p><T en="Production startup never migrates implicitly. Verify the release manifest, run migrate apply as a dedicated release job, and ship a single Rust binary." zh="生产启动永不隐式迁移；先校验不可变发布清单，再在独立发布任务中执行 migrate apply，最终交付单二进制 Rust 服务。" /></p>
              <code class="delivery-cmd">appstruct build &amp;&amp; appstruct deploy verify</code>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="final-cta dark-section">
      <div class="section-inner final-layout">
        <div>
          <p class="eyebrow">APPSTRUCT / TECHNICAL PREVIEW / 0.2.0</p>
          <h2><T en="Write YAML.<br>Ship Rust with confidence." zh="编写 YAML。<br>放心交付 Rust 全栈。" /></h2>
        </div>
        <div class="final-action">
          <p><T en="Connect your AI coding agent via MCP, introspect an existing PostgreSQL database, or create a fresh SaaS project from the workspace." zh="通过内置 MCP 接入 AI Coding Agent，或内省已有 PostgreSQL 数据库，或直接从模板创建全新 SaaS 项目。" /></p>
          <BracketLink href={startHref}><T en="Open the quick start" zh="打开快速开始" /> <ArrowRight size={15} /></BracketLink>
          <span>Rust 1.89+ · PostgreSQL 17 · React 19 · Node 24</span>
        </div>
      </div>
    </section>
  </main>
</Base>
